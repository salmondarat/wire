# ---------------------------------------------------------------------------
# CompanyOS — wire documentation & planning repo
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Hidden / dotfiles — ignore all unless explicitly tracked
# (add exceptions below with "!")
# ---------------------------------------------------------------------------
.*
!.gitignore
!.gitkeep

# ---------------------------------------------------------------------------
# Agent / tool config directories
# ---------------------------------------------------------------------------
.commandcode
.claude
.agent
.vscode
.idea
*.code-workspace

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Editors — VS Code, Vim, Neovim, Emacs
# ---------------------------------------------------------------------------
# VS Code
.vscode/settings.local.json
.vscode/*.local.json

# Vim / Neovim
*.swp
*.swo
*~
.runtimepackages
.javascript_extensions
.javascript_map
.node_repl_history
.lua_extensions

# Emacs
*#
.autorc
.dir-locals.el
.recorder

# ---------------------------------------------------------------------------
# Node.js / JavaScript / TypeScript
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.nuxt
.output
.next
.nyc_output
coverage/
.eslintcache
.prettiercache
jest.config.js
jest.config.ts
jest.setup.js
jest.setup.ts
babel.config.js
babel.config.ts
.eslintrc*
.prettierrc*
.stylelintrc*
.editorconfig
# Only track .editorconfig at root if intentional
# .editorconfig

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/
pip-wheel-metadata/
venv/
.venv/
env/
.env
.env.local
.env.*.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
uv.lock
poetry.lock
Pipfile.lock

